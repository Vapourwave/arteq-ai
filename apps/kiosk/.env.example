# ARTEQ AI kiosk — Vite exposes VITE_* variables to the BROWSER.
# Never put a secret here. This file must only ever contain non-sensitive,
# client-safe configuration.

# Backend WebSocket endpoint for the voice pipeline.
VITE_BACKEND_WS_URL=ws://localhost:8787/api/live

# Backend HTTP origin for the Phase 4 transcript refinement + quality-guard
# endpoint (POST /api/transcript/process).
VITE_BACKEND_HTTP_URL=http://localhost:8787

# "development" = manual tap-to-simulate presence (default, safe anywhere).
# "camera" = webcam motion-based presence detection (requires camera access
# and real-device tuning; not verified in this environment).
VITE_PRESENCE_MODE=development

# Set to "true" to show developer-only affordances (the TTS evaluation
# screen) on the idle screen. Leave unset for anything a client sees —
# see src/config/demo.ts and docs/demo-script.md.
VITE_SHOW_DEV_TOOLS=false
