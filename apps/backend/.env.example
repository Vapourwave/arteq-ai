# ARTEQ AI backend — server-side secrets only. Never commit a real .env file.

# Required for Gemini Live voice capture (docs/04 AI Voice spec).
GEMINI_API_KEY=

# Reserved for future Sarvam TTS integration (docs/04 §17). Not implemented
# yet — see src/providers/tts/ReservedTTSProvider.ts.
SARVAM_API_KEY=

# Fish Audio S2 Pro — EXPERIMENTAL TTS provider under evaluation, dev-only
# test harness (see src/providers/tts/FishTTSProvider.ts). Not wired into the
# real patient pipeline. Leave unset to keep it reporting unconfigured.
FISH_API_KEY=

# HTTP + WebSocket port for the backend.
PORT=8787

# --- Phone channel (docs/07-phone-channel.md) ---------------------------------
# All optional. Leave unset to keep the phone channel dormant — the kiosk
# voice channel is unaffected either way.

# Twilio account Auth Token. Used ONLY to verify the X-Twilio-Signature on the
# inbound-call webhook. When unset the webhook still responds but is not
# signature-verified (a startup warning is logged) — set it before exposing
# the endpoint publicly.
TWILIO_AUTH_TOKEN=

# Public host (NO scheme, NO trailing slash) that Twilio can reach this
# backend at: a tunnel host in local dev (e.g. abcd-12-34.ngrok-free.app),
# the real domain in production. Required to build the wss://.../api/phone/media
# URL handed to Twilio in the TwiML response.
PHONE_PUBLIC_HOST=

# Shared secret sent to Twilio as a <Parameter> on the media stream and
# checked when the stream starts, so an unsolicited WebSocket connection to
# /api/phone/media is rejected. Recommended whenever PHONE_PUBLIC_HOST is set.
PHONE_STREAM_SHARED_SECRET=
