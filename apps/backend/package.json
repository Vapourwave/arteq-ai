{
  "name": "@arteq/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval:transcript": "tsx scripts/eval-transcript-refinement.ts",
    "verify:voice": "tsx scripts/verify-voice.ts"
  },
  "dependencies": {
    "@arteq/shared": "*",
    "@google/genai": "^1.5.1",
    "express": "^4.21.2",
    "firebase-admin": "^14.4.0",
    "twilio": "^6.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2",
    "vitest": "^3.0.5"
  }
}
